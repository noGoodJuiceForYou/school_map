<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.map.mapper.PendingReviewImagesMapper">

    <insert id="add">
        insert into pending_review_images(user_id,location_id,sub_location_id,url,time)
        values(#{userId},#{locationId},#{subLocationId},#{url},#{time})
    </insert>
</mapper>
